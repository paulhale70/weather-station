// Copy this file to secrets.h (same folder) and fill in your values.
// secrets.h is git-ignored, so it never ends up in the public repo.
#pragma once

#define WIFI_SSID      "your-wifi-name"     // ESP32 only supports 2.4 GHz Wi-Fi
#define WIFI_PASSWORD  "your-wifi-password"

// The PC running server/receiver.py. Use its LAN IP and port.
#define RECEIVER_URL   "http://10.0.0.67:8080/api/readings"

// Must match WS_TOKEN on the receiver. Any long random string.
#define STATION_TOKEN  "change-me"

#define DEVICE_ID      "backyard"
